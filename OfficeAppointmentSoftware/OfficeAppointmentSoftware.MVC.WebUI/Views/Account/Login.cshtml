@model LoginVM
@{
    Layout = null;
    ViewData["Title"] = "Giriş";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <partial name="_Head" />
</head>
<body>
    <div class="auth-shell">
        <section class="auth-hero">
            <a class="d-flex align-items-center gap-2 text-white text-decoration-none fw-bold fs-5" asp-controller="Home" asp-action="Index">
                <span class="brand-mark"><i class="bi bi-calendar2-heart"></i></span> CETRIS
            </a>
            <div>
                <h2>Danışmanlık ofisinizi tek ekrandan yönetin.</h2>
                <ul>
                    <li><i class="bi bi-calendar-check"></i> Uzman bazlı randevu takvimi</li>
                    <li><i class="bi bi-people"></i> Danışan kayıtları ve randevu geçmişi</li>
                    <li><i class="bi bi-graph-up"></i> Günlük ve haftalık özet</li>
                </ul>
            </div>
            <small class="opacity-75">© @DateTime.Now.Year CETRIS</small>
        </section>

        <section class="auth-panel">
            <div class="auth-card">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <a class="d-flex d-lg-none align-items-center gap-2 text-decoration-none fw-bold text-body" asp-controller="Home" asp-action="Index">
                        <span class="brand-mark"><i class="bi bi-calendar2-heart"></i></span> CETRIS
                    </a>
                    <a class="small text-decoration-none d-none d-lg-inline" asp-controller="Home" asp-action="Index"><i class="bi bi-arrow-left me-1"></i>Ana sayfa</a>
                    <button class="icon-btn" type="button" data-theme-toggle aria-label="Temayı değiştir"><i class="bi bi-moon-stars" data-theme-icon></i></button>
                </div>

                <h1 class="h3 fw-bold mb-1">Hoş geldiniz</h1>
                <p class="text-body-secondary mb-4">Devam etmek için hesabınıza giriş yapın.</p>

                <form asp-controller="Account" asp-action="Login" asp-route-returnUrl="@ViewBag.ReturnUrl" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="UserName" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-person"></i></span>
                            <input asp-for="UserName" class="form-control" autocomplete="username" autofocus />
                        </div>
                        <span asp-validation-for="UserName"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-lock"></i></span>
                            @* The password input never echoes the typed value back into the page. *@
                            <input asp-for="Password" class="form-control" autocomplete="current-password" id="Password" />
                            <button class="btn btn-outline-secondary" type="button" id="togglePassword" aria-label="Şifreyi göster"><i class="bi bi-eye"></i></button>
                        </div>
                        <span asp-validation-for="Password"></span>
                    </div>

                    <div class="form-check mb-4">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label"></label>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 btn-icon justify-content-center"><i class="bi bi-box-arrow-in-right"></i> Giriş Yap</button>
                </form>

                <p class="text-body-secondary small mt-4 mb-0">Hesabınız yok mu? Ofis hesapları yönetici tarafından açılır; <a asp-controller="Home" asp-action="Index" asp-fragment="contact">bizimle iletişime geçin</a>.</p>
            </div>
        </section>
    </div>

    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/app.js" asp-append-version="true"></script>
    <script>
        document.getElementById('togglePassword').addEventListener('click', function () {
            var input = document.getElementById('Password');
            var show = input.type === 'password';
            input.type = show ? 'text' : 'password';
            this.querySelector('i').className = show ? 'bi bi-eye-slash' : 'bi bi-eye';
            this.setAttribute('aria-label', show ? 'Şifreyi gizle' : 'Şifreyi göster');
        });
    </script>
</body>
</html>
