<!DOCTYPE html>
<html lang="tr">
<head>
    <partial name="_Head" />
    <meta name="description" content="CETRIS: danışmanlık merkezleri için danışan, uzman ve randevu yönetimi." />
</head>
<body class="landing" data-bs-spy="scroll" data-bs-target="#landingNav" data-bs-offset="80">
    <nav class="navbar navbar-expand-lg fixed-top landing-nav py-3" id="landingNav">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center gap-2 fw-bold" href="#top">
                <span class="brand-mark"><i class="bi bi-calendar2-heart"></i></span> CETRIS
            </a>
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#landingMenu" aria-controls="landingMenu" aria-expanded="false" aria-label="Menüyü aç">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="landingMenu">
                <ul class="navbar-nav mx-auto gap-lg-2">
                    <li class="nav-item"><a class="nav-link" href="#about">Hakkımızda</a></li>
                    <li class="nav-item"><a class="nav-link" href="#services">Hizmetler</a></li>
                    <li class="nav-item"><a class="nav-link" href="#works">Çalışmalar</a></li>
                    <li class="nav-item"><a class="nav-link" href="#pricing">Paketler</a></li>
                    <li class="nav-item"><a class="nav-link" href="#testimonials">Yorumlar</a></li>
                    <li class="nav-item"><a class="nav-link" href="#contact">İletişim</a></li>
                </ul>
                <div class="d-flex align-items-center gap-2 mt-3 mt-lg-0">
                    <button class="icon-btn" type="button" data-theme-toggle aria-label="Temayı değiştir"><i class="bi bi-moon-stars" data-theme-icon></i></button>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a class="btn btn-primary btn-icon" asp-controller="Account" asp-action="Login"><i class="bi bi-speedometer2"></i> Panele Git</a>
                    }
                    else
                    {
                        <a class="btn btn-primary btn-icon" asp-controller="Account" asp-action="Login"><i class="bi bi-box-arrow-in-right"></i> Giriş Yap</a>
                    }
                </div>
            </div>
        </div>
    </nav>

    <main id="top">
        @RenderBody()
    </main>

    <footer class="landing-footer">
        <div class="container d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
            <div class="d-flex align-items-center gap-2 text-white fw-semibold">
                <span class="brand-mark" style="width:28px;height:28px;font-size:.9rem"><i class="bi bi-calendar2-heart"></i></span> CETRIS
            </div>
            <div class="small">© @DateTime.Now.Year CETRIS · Tüm hakları saklıdır.</div>
            <div class="small"><a href="#contact">Bize ulaşın</a></div>
        </div>
    </footer>

    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/app.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
