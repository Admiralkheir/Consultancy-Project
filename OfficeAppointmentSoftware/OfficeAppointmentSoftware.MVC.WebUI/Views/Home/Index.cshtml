@model UserContact
@{
    var plans = Model.Plans.ToList();
    var featured = plans.Count >= 3 ? plans[plans.Count / 2].PlanID : (short)0;
    var generalDescription = Model.Features.Select(f => f.GeneralDescription).FirstOrDefault(d => !string.IsNullOrWhiteSpace(d));
}

<section class="hero">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-7">
                <span class="badge rounded-pill bg-white bg-opacity-10 border border-white border-opacity-25 px-3 py-2 mb-3">
                    <i class="bi bi-stars me-1"></i> Danışmanlık merkezleri için randevu sistemi
                </span>
                <h1 class="mb-3">@(Model.Banner?.Title ?? "Danışanlarınız, uzmanlarınız ve randevularınız tek yerde")</h1>
                <p class="lead mb-4">@(Model.Banner?.Description ?? "Psikolojik danışmanlık ve uzman–danışan ilişkisi yürüten ofisler için dijital randevu ve kayıt yönetimi.")</p>
                <div class="d-flex flex-wrap gap-2">
                    <a class="btn btn-light btn-lg btn-icon fw-semibold" asp-controller="Account" asp-action="Login"><i class="bi bi-box-arrow-in-right"></i> Giriş Yap</a>
                    <a class="btn btn-outline-light btn-lg" href="#contact">Bize Ulaşın</a>
                </div>
            </div>
            <div class="col-lg-5">
                <div class="hero-card">
                    <div class="fw-semibold mb-2"><i class="bi bi-check2-circle me-1"></i> Neler sunuyoruz?</div>
                    <div class="row-item"><i class="bi bi-calendar3 fs-5"></i><div><div class="fw-semibold">Randevu takvimi</div><small class="opacity-75">Sürükle-bırak ile planlama, çakışma kontrolü</small></div></div>
                    <div class="row-item"><i class="bi bi-people fs-5"></i><div><div class="fw-semibold">Danışan kayıtları</div><small class="opacity-75">İletişim bilgileri ve randevu geçmişi</small></div></div>
                    <div class="row-item"><i class="bi bi-person-badge fs-5"></i><div><div class="fw-semibold">Uzman yönetimi</div><small class="opacity-75">Uzmanlık alanları ve fiyat politikaları</small></div></div>
                    <div class="row-item"><i class="bi bi-shield-lock fs-5"></i><div><div class="fw-semibold">Ofise özel veri</div><small class="opacity-75">Her ofis yalnızca kendi kayıtlarını görür</small></div></div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section" id="about">
    <div class="container">
        <div class="text-center mb-5">
            <div class="section-eyebrow">Hakkımızda</div>
            <h2 class="section-title">Neye inanıyoruz?</h2>
        </div>
        <div class="row g-4">
            <div class="col-md-6 col-lg-3">
                <div class="card h-100 lift"><div class="card-body">
                    <div class="feature-icon"><i class="bi bi-bullseye"></i></div>
                    <h3 class="h5 fw-bold">Misyon</h3>
                    <p class="text-body-secondary mb-0">CETRIS, verdiği hizmetlerde öncelikle kaliteli iş prensibiyle müşterilerine ilk aşamadan son aşamaya kadar çözüm ve destek sunar. En yeni, en güvenli ve en pratik teknolojileri sistemine katarak güvenilir ve yenilikçi bir hizmet anlayışını benimser.</p>
                </div></div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="card h-100 lift"><div class="card-body">
                    <div class="feature-icon"><i class="bi bi-eye"></i></div>
                    <h3 class="h5 fw-bold">Vizyon</h3>
                    <p class="text-body-secondary mb-0">Her zaman güvenilir olmak ve ihtiyaca göre çözüm yelpazesini genişletmek. Hizmetin tüm aşamalarında anlaşılır, sade ve pratik bir destek süreci kurmak en büyük hedeflerimizden biridir.</p>
                </div></div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="card h-100 lift"><div class="card-body">
                    <div class="feature-icon"><i class="bi bi-cash-coin"></i></div>
                    <h3 class="h5 fw-bold">Fiyat Anlayışımız</h3>
                    <p class="text-body-secondary mb-0">Sektörde fiyatlar, hizmet çeşitliliği ve standart eksikliği nedeniyle büyük farklılıklar gösterir. CETRIS, profesyonel iş anlayışına uygun olarak standart ve şeffaf paketler sunar.</p>
                </div></div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="card h-100 lift"><div class="card-body">
                    <div class="feature-icon"><i class="bi bi-shield-check"></i></div>
                    <h3 class="h5 fw-bold">Güvenli</h3>
                    <p class="text-body-secondary mb-0">Önceliğimiz, kullanıcılarımızın değerli bilgilerini güvenli bir şekilde saklamak ve onlara sunmaktır. Bu özellikler bizi biz yapıyor.</p>
                </div></div>
            </div>
        </div>
    </div>
</section>

@if (Model.Features.Any())
{
    <section class="section section-alt" id="services">
        <div class="container">
            <div class="text-center mb-5 mx-auto" style="max-width:46rem">
                <div class="section-eyebrow">Hizmetler</div>
                <h2 class="section-title">Ne yapıyoruz?</h2>
                @if (generalDescription != null)
                {
                    <p class="text-body-secondary fs-5 mt-3">@generalDescription</p>
                }
            </div>
            <div class="row g-4">
                @foreach (var item in Model.Features)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100 lift"><div class="card-body">
                            <div class="feature-icon"><i class="bi bi-heart-pulse"></i></div>
                            <h3 class="h5 fw-bold">@item.Title</h3>
                            <p class="text-body-secondary mb-0">@item.Description</p>
                        </div></div>
                    </div>
                }
            </div>
        </div>
    </section>
}

@if (Model.Works.Any())
{
    <section class="section" id="works">
        <div class="container">
            <div class="text-center mb-5">
                <div class="section-eyebrow">Çalışmalar</div>
                <h2 class="section-title">Son çalışmalarımız</h2>
            </div>
            <div class="row g-4">
                @foreach (var item in Model.Works)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100 lift work-card">
                            <img src="~/Areas/Admin/Files/Images/@item.PhotoURL" class="w-100" alt="@item.Title" loading="lazy" />
                            <div class="card-body">
                                <h3 class="h5 fw-bold">@item.Title</h3>
                                <p class="text-body-secondary mb-0">@item.Description</p>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}

@if (plans.Any())
{
    <section class="section section-alt" id="pricing">
        <div class="container">
            <div class="text-center mb-5">
                <div class="section-eyebrow">Paketler</div>
                <h2 class="section-title">Ofisinize uygun paketi seçin</h2>
                <p class="text-body-secondary">Tüm paketlerde randevu takvimi, danışan ve uzman yönetimi bulunur.</p>
            </div>
            <div class="row g-4 justify-content-center">
                @foreach (var plan in plans)
                {
                    var isFeatured = plan.PlanID == featured;
                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100 price-card lift @(isFeatured ? "featured" : "")">
                            <div class="card-body p-4 d-flex flex-column">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <h3 class="h5 fw-bold mb-0">@plan.PlanName</h3>
                                    @if (isFeatured)
                                    {
                                        <span class="badge rounded-pill text-bg-primary">Popüler</span>
                                    }
                                </div>
                                <div class="price my-2">@UiHelper.Money(plan.Price)</div>
                                <div class="text-body-secondary small mb-4">+ KDV</div>
                                <ul class="list-unstyled mb-4 d-grid gap-2">
                                    <li><i class="bi bi-check2 text-primary me-2"></i>Randevu takvimi</li>
                                    <li><i class="bi bi-check2 text-primary me-2"></i>Danışan ve uzman kayıtları</li>
                                    <li><i class="bi bi-check2 text-primary me-2"></i>Günlük ve haftalık özet</li>
                                </ul>
                                <a href="#contact" class="btn @(isFeatured ? "btn-primary" : "btn-outline-primary") mt-auto">Bilgi Al</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}

<section class="section" id="testimonials">
    <div class="container">
        <div class="text-center mb-5">
            <div class="section-eyebrow">Yorumlar</div>
            <h2 class="section-title">Bizimle çalışanlar ne diyor?</h2>
        </div>
        <div class="row g-4">
            @{
                var testimonials = new[]
                {
                    ("Aytul.jpg", "Aytül Türkseven", "Müdür, T7", "CETRIS her zaman sadece yapabileceği işe söz veren, dürüst, yaptığı işin arkasında duran, işini temiz yapan, kendisini devamlı güncelleyen profesyonel bir firmadır. Kesinlikle tavsiye ederim."),
                    ("Kral.jpg", "Tugay Ersoy", "CEO", "CETRIS ekibine teşekkürü borç bilirim. Teşekkürler CETRIS."),
                    ("Betul.jpg", "Betül Şenoğlu", "CEO", "Öncelikle CETRIS'e güveniyoruz, en önemlisi bu. Destek sistemi mükemmel, sorun yaşatmadığı için teşekkür etmek istiyorum."),
                    ("merve.jpg", "Merve Özdemir", "CEO", "CETRIS ile ilgili beni en çok etkileyen, beklentileri doğru anlamak için yakın çalışmaya gösterdikleri gayret oldu. İşlerinde uzman, deneyimli ve hepsinden önemlisi çok hızlı destek veriyorlar.")
                };
            }
            @foreach (var (photo, name, role, quote) in testimonials)
            {
                <div class="col-md-6 col-lg-3">
                    <figure class="card h-100 testimonial mb-0"><div class="card-body d-flex flex-column">
                        <i class="bi bi-quote fs-1 text-primary opacity-50 lh-1"></i>
                        <blockquote class="flex-grow-1 text-body-secondary">@quote</blockquote>
                        <figcaption class="d-flex align-items-center gap-3 mt-3">
                            <img src="~/img/testimonials/@photo" alt="" loading="lazy" />
                            <div><div class="fw-semibold">@name</div><small class="text-body-secondary">@role</small></div>
                        </figcaption>
                    </div></figure>
                </div>
            }
        </div>
    </div>
</section>

<section class="section section-alt" id="contact">
    <div class="container">
        <div class="row g-5">
            <div class="col-lg-5">
                <div class="section-eyebrow">İletişim</div>
                <h2 class="section-title">Bize ulaşın</h2>
                <p class="text-body-secondary mb-4">Paketlerimiz hakkında bilgi almak, istek veya şikayetlerinizi iletmek için bize yazın. Ekibimiz en kısa sürede dönüş yapacaktır.</p>
                <div class="d-grid gap-3">
                    <div class="d-flex gap-3 align-items-center"><span class="stat-icon tone-indigo"><i class="bi bi-geo-alt"></i></span><div>Çırağan Caddesi No: 25<br />Beşiktaş / İstanbul</div></div>
                    <div class="d-flex gap-3 align-items-center"><span class="stat-icon tone-teal"><i class="bi bi-envelope"></i></span><a href="mailto:info@cetris.com">info@cetris.com</a></div>
                    <div class="d-flex gap-3 align-items-center"><span class="stat-icon tone-amber"><i class="bi bi-telephone"></i></span><a href="tel:+902122121212">0212 212 12 12</a></div>
                </div>
            </div>
            <div class="col-lg-7">
                <div class="card"><div class="card-body p-4">
                    @if (TempData["Success"] is string sent)
                    {
                        <div class="alert alert-success"><i class="bi bi-check-circle me-2"></i>@sent</div>
                    }
                    @if (TempData["Error"] is string failed)
                    {
                        <div class="alert alert-warning"><i class="bi bi-exclamation-triangle me-2"></i>@failed</div>
                    }
                    <form asp-controller="Home" asp-action="EmailSend" method="post" novalidate>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="NameSurname" class="form-label"></label>
                                <input asp-for="NameSurname" class="form-control" autocomplete="name" />
                                <span asp-validation-for="NameSurname"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="EMail" class="form-label"></label>
                                <input asp-for="EMail" class="form-control" type="email" autocomplete="email" />
                                <span asp-validation-for="EMail"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="Subject" class="form-label"></label>
                                <input asp-for="Subject" class="form-control" />
                                <span asp-validation-for="Subject"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="Message" class="form-label"></label>
                                <textarea asp-for="Message" class="form-control" rows="5"></textarea>
                                <span asp-validation-for="Message"></span>
                            </div>
                            <div class="col-12">
                                <button type="submit" class="btn btn-primary btn-icon"><i class="bi bi-send"></i> Gönder</button>
                            </div>
                        </div>
                    </form>
                </div></div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @if (ViewBag.ScrollToContact == true)
    {
        <script>document.getElementById('contact').scrollIntoView();</script>
    }
}
