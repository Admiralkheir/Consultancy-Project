@model List<Works>
@{
    ViewData["Title"] = "Çalışmalar";
}

<div class="page-header">
    <div>
        <h1>Çalışmalar</h1>
        <p class="lead-text">Ana sayfadaki "Son çalışmalarımız" bölümünde görselleriyle listelenir.</p>
    </div>
    <a class="btn btn-primary btn-icon" asp-action="WorksAdd"><i class="bi bi-plus-lg"></i> Yeni Çalışma</a>
</div>

@if (!Model.Any())
{
    <div class="card"><div class="empty-state"><i class="bi bi-images"></i>Henüz çalışma eklenmemiş; ana sayfada bu bölüm gizlenir.</div></div>
}
else
{
    <div class="row g-4">
        @foreach (var item in Model)
        {
            <div class="col-md-6 col-xl-4">
                <div class="card h-100 work-card">
                    <img src="~/Areas/Admin/Files/Images/@item.PhotoURL" class="w-100" alt="@item.Title" loading="lazy" />
                    <div class="card-body d-flex flex-column">
                        <h2 class="h6 fw-bold">@item.Title</h2>
                        <p class="text-body-secondary small flex-grow-1">@item.Description</p>
                        <div class="d-flex gap-2">
                            <a class="btn btn-sm btn-light flex-fill" asp-action="WorksUpdate" asp-route-id="@item.WorksID"><i class="bi bi-pencil me-1"></i>Düzenle</a>
                            <form asp-action="WorksDelete" asp-route-id="@item.WorksID" method="post"
                                  data-confirm="&quot;@item.Title&quot; ve görseli kaldırılacak." data-confirm-title="Çalışma silinsin mi?">
                                <button type="submit" class="btn btn-sm btn-light text-danger" title="Sil"><i class="bi bi-trash"></i><span class="visually-hidden">Sil</span></button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
