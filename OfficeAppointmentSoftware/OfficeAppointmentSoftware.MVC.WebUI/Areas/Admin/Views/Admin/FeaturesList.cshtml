@model List<Features>
@{
    ViewData["Title"] = "Hizmetler";
}

<div class="page-header">
    <div>
        <h1>Hizmetler</h1>
        <p class="lead-text">Ana sayfadaki "Ne yapıyoruz?" bölümünde listelenir.</p>
    </div>
    <a class="btn btn-primary btn-icon" asp-action="FeaturesAdd"><i class="bi bi-plus-lg"></i> Yeni Hizmet</a>
</div>

@if (!Model.Any())
{
    <div class="card"><div class="empty-state"><i class="bi bi-stars"></i>Henüz hizmet eklenmemiş; ana sayfada bu bölüm gizlenir.</div></div>
}
else
{
    <div class="row g-4">
        @foreach (var item in Model)
        {
            <div class="col-md-6 col-xl-4">
                <div class="card h-100">
                    <div class="card-body d-flex flex-column">
                        <h2 class="h6 fw-bold">@item.Title</h2>
                        <p class="text-body-secondary small flex-grow-1">@item.Description</p>
                        <div class="d-flex gap-2">
                            <a class="btn btn-sm btn-light flex-fill" asp-action="FeaturesUpdate" asp-route-id="@item.FeaturesID"><i class="bi bi-pencil me-1"></i>Düzenle</a>
                            <form asp-action="FeaturesDelete" asp-route-id="@item.FeaturesID" method="post"
                                  data-confirm="&quot;@item.Title&quot; ana sayfadan kaldırılacak." data-confirm-title="Hizmet silinsin mi?">
                                <button type="submit" class="btn btn-sm btn-light text-danger" title="Sil"><i class="bi bi-trash"></i><span class="visually-hidden">Sil</span></button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
