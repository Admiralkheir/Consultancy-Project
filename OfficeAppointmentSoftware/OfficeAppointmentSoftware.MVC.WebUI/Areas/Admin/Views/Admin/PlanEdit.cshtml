@model Plans
@{
    var isNew = Model.PlanID == 0;
    ViewData["Title"] = isNew ? "Yeni Paket" : "Paketi Düzenle";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Plans">Paketler</a></li>
        <li class="breadcrumb-item active" aria-current="page">@(isNew ? "Yeni" : Model.PlanName)</li>
    </ol>
</nav>

<div class="page-header"><h1>@ViewData["Title"]</h1></div>

<div class="card" style="max-width:560px">
    <div class="card-body">
        <form asp-action="PlanEdit" method="post" novalidate>
            <input asp-for="PlanID" type="hidden" />
            <div class="mb-3">
                <label asp-for="PlanName" class="form-label"></label>
                <input asp-for="PlanName" class="form-control" placeholder="örn. Standart" />
                <span asp-validation-for="PlanName"></span>
            </div>
            <div class="mb-4">
                <label asp-for="Price" class="form-label"></label>
                <div class="input-group">
                    <input asp-for="Price" class="form-control" type="number" min="0" step="1" />
                    <span class="input-group-text">₺ + KDV</span>
                </div>
                <span asp-validation-for="Price"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-icon"><i class="bi bi-check2"></i> Kaydet</button>
                <a class="btn btn-light" asp-action="Plans">Vazgeç</a>
            </div>
        </form>
    </div>
</div>
