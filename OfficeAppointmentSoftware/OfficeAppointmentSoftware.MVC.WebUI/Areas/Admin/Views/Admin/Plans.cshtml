@model List<PlanListItemVM>
@{
    ViewData["Title"] = "Paketler";
}

<div class="page-header">
    <div>
        <h1>Paketler</h1>
        <p class="lead-text">Ofislere atanan paketler; ana sayfadaki fiyat tablosunda da gösterilir.</p>
    </div>
    <a class="btn btn-primary btn-icon" asp-action="PlanEdit"><i class="bi bi-plus-lg"></i> Yeni Paket</a>
</div>

<div class="card">
    @if (!Model.Any())
    {
        <div class="empty-state"><i class="bi bi-tags"></i>Henüz paket yok.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead><tr><th>Paket</th><th class="text-end">Fiyat</th><th class="text-end">Ofis</th><th class="text-end">İşlemler</th></tr></thead>
                <tbody>
                    @foreach (var plan in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@plan.PlanName</td>
                            <td class="text-end">@UiHelper.Money(plan.Price) <span class="small text-body-secondary">+ KDV</span></td>
                            <td class="text-end">@plan.OfficeCount</td>
                            <td class="text-end text-nowrap">
                                <a class="btn btn-sm btn-light" asp-action="PlanEdit" asp-route-id="@plan.PlanID" title="Düzenle"><i class="bi bi-pencil"></i><span class="visually-hidden">Düzenle</span></a>
                                <form asp-action="PlanDelete" asp-route-id="@plan.PlanID" method="post" class="d-inline"
                                      data-confirm="&quot;@plan.PlanName&quot; paketi silinecek." data-confirm-title="Paket silinsin mi?">
                                    <button type="submit" class="btn btn-sm btn-light text-danger" title="@(plan.OfficeCount > 0 ? "Bu paketi kullanan ofisler var" : "Sil")" disabled="@(plan.OfficeCount > 0)"><i class="bi bi-trash"></i><span class="visually-hidden">Sil</span></button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
