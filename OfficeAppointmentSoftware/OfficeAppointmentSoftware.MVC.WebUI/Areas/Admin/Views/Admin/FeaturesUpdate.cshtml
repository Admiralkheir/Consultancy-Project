@model Features
@{
    var isNew = Model.FeaturesID == 0;
    ViewData["Title"] = isNew ? "Yeni Hizmet" : "Hizmeti Düzenle";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="FeaturesList">Hizmetler</a></li>
        <li class="breadcrumb-item active" aria-current="page">@(isNew ? "Yeni" : "Düzenle")</li>
    </ol>
</nav>

<div class="page-header"><h1>@ViewData["Title"]</h1></div>

<div class="card" style="max-width:720px">
    <div class="card-body">
        <form asp-action="FeaturesUpdate" method="post" novalidate>
            <input asp-for="FeaturesID" type="hidden" />
            <div class="mb-3">
                <label asp-for="Title" class="form-label"></label>
                <input asp-for="Title" class="form-control" placeholder="örn. Bireysel Terapi" />
                <span asp-validation-for="Title"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="4" maxlength="300"></textarea>
                <span asp-validation-for="Description"></span>
            </div>
            <div class="mb-4">
                <label asp-for="GeneralDescription" class="form-label"></label>
                <textarea asp-for="GeneralDescription" class="form-control" rows="3" maxlength="300"></textarea>
                <div class="form-text">Bölüm başlığının altında görünen giriş metni. İlk hizmetin metni kullanılır.</div>
                <span asp-validation-for="GeneralDescription"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-icon"><i class="bi bi-check2"></i> Kaydet</button>
                <a class="btn btn-light" asp-action="FeaturesList">Vazgeç</a>
            </div>
        </form>
    </div>
</div>
