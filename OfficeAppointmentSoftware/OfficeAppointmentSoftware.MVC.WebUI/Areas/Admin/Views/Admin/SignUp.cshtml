@model SignUpVM
@{
    ViewData["Title"] = "Yeni Ofis";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Ofisler</a></li>
        <li class="breadcrumb-item active" aria-current="page">Yeni ofis</li>
    </ol>
</nav>

<div class="page-header">
    <div>
        <h1>Yeni Ofis</h1>
        <p class="lead-text">Ofis kaydını ve ofisin giriş yapacağı kullanıcı hesabını birlikte oluşturur.</p>
    </div>
</div>

@if (!Model.DropDownList.Any())
{
    <div class="alert alert-warning">
        <i class="bi bi-exclamation-triangle me-1"></i> Ofis oluşturmak için önce bir paket tanımlamalısınız.
        <a asp-action="PlanEdit" class="alert-link">Paket ekleyin</a>.
    </div>
}

<form asp-action="SignUp" method="post" enctype="multipart/form-data" novalidate>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <div class="row g-4">
        <div class="col-xl-8">
            <div class="card mb-4">
                <div class="card-body">
                    <div class="form-section-title">Ofis bilgileri</div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="NewCompany.CompanyName" class="form-label"></label>
                            <input asp-for="NewCompany.CompanyName" class="form-control" />
                            <span asp-validation-for="NewCompany.CompanyName"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="NewCompany.OwnerName" class="form-label"></label>
                            <input asp-for="NewCompany.OwnerName" class="form-control" />
                            <span asp-validation-for="NewCompany.OwnerName"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="SelectedPlanID" class="form-label"></label>
                            <select asp-for="SelectedPlanID" asp-items="Model.DropDownList" class="form-select">
                                <option value="0">Paket seçiniz…</option>
                            </select>
                            <span asp-validation-for="SelectedPlanID"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="logo">Logo <span class="text-body-secondary small fw-normal">(isteğe bağlı)</span></label>
                            <input class="form-control" type="file" name="file" id="logo" accept="image/*" />
                            @Html.ValidationMessage("file")
                        </div>
                        <div class="col-12">
                            <label asp-for="NewCompany.Description" class="form-label"></label> <span class="text-body-secondary small">(isteğe bağlı)</span>
                            <textarea asp-for="NewCompany.Description" class="form-control" rows="2" maxlength="450"></textarea>
                            <span asp-validation-for="NewCompany.Description"></span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card mb-4">
                <div class="card-body">
                    <div class="form-section-title">İletişim</div>
                    <partial name="_ContactFields" for="NewContact" />
                </div>
            </div>
        </div>
        <div class="col-xl-4">
            <div class="card mb-4">
                <div class="card-body">
                    <div class="form-section-title">Giriş hesabı</div>
                    <div class="mb-3">
                        <label asp-for="Username" class="form-label"></label>
                        <input asp-for="Username" class="form-control" autocomplete="off" />
                        <span asp-validation-for="Username"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="Password"></span>
                        <div class="form-text">En az 6 karakter.</div>
                    </div>
                    <div>
                        <label asp-for="ConfirmPassword" class="form-label"></label>
                        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmPassword"></span>
                    </div>
                </div>
            </div>
            <div class="d-grid gap-2">
                <button type="submit" class="btn btn-primary btn-icon justify-content-center"><i class="bi bi-check2"></i> Ofisi Oluştur</button>
                <a class="btn btn-light" asp-action="Index">Vazgeç</a>
            </div>
        </div>
    </div>
</form>
