@model Works
@{
    var isNew = Model.WorksID == 0;
    ViewData["Title"] = isNew ? "Yeni Çalışma" : "Çalışmayı Düzenle";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="WorksList">Çalışmalar</a></li>
        <li class="breadcrumb-item active" aria-current="page">@(isNew ? "Yeni" : "Düzenle")</li>
    </ol>
</nav>

<div class="page-header"><h1>@ViewData["Title"]</h1></div>

<div class="card" style="max-width:720px">
    <div class="card-body">
        <form asp-action="WorksUpdate" method="post" enctype="multipart/form-data" novalidate>
            <input asp-for="WorksID" type="hidden" />
            <input asp-for="PhotoURL" type="hidden" />
            <div class="mb-3">
                <label class="form-label" for="workPhoto">Görsel @if (!isNew) {<span class="text-body-secondary small fw-normal">(değiştirmek için yeni dosya seçin)</span>}</label>
                <img id="workPreview" class="d-block rounded-3 mb-2 @(string.IsNullOrEmpty(Model.PhotoURL) ? "d-none" : "")" style="max-height:200px;max-width:100%;object-fit:cover"
                     src="@(string.IsNullOrEmpty(Model.PhotoURL) ? null : Url.Content("~/Areas/Admin/Files/Images/" + Model.PhotoURL))" alt="" />
                <input class="form-control" type="file" name="file" id="workPhoto" accept="image/*" data-preview="#workPreview" />
                @Html.ValidationMessage("file")
                <div class="form-text">PNG, JPG veya GIF, en fazla 500 KB.</div>
            </div>
            <div class="mb-3">
                <label asp-for="Title" class="form-label"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title"></span>
            </div>
            <div class="mb-4">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="4" maxlength="300"></textarea>
                <span asp-validation-for="Description"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-icon"><i class="bi bi-check2"></i> Kaydet</button>
                <a class="btn btn-light" asp-action="WorksList">Vazgeç</a>
            </div>
        </form>
    </div>
</div>
