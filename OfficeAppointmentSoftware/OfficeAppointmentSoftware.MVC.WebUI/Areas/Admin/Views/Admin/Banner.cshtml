@model Banner
@{
    ViewData["Title"] = "Karşılama Alanı";
}

<div class="page-header">
    <div>
        <h1>Karşılama Alanı</h1>
        <p class="lead-text">Ana sayfanın en üstünde görünen başlık ve açıklama.</p>
    </div>
    <a class="btn btn-light btn-icon" asp-area="" asp-controller="Home" asp-action="Index" target="_blank" rel="noopener"><i class="bi bi-box-arrow-up-right"></i> Siteyi görüntüle</a>
</div>

<div class="row g-4">
    <div class="col-lg-6">
        <div class="card">
            <div class="card-body">
                <form asp-action="Banner" method="post" novalidate>
                    <input asp-for="BannerID" type="hidden" />
                    <div class="mb-3">
                        <label asp-for="Title" class="form-label"></label>
                        <input asp-for="Title" class="form-control" id="bannerTitle" />
                        <span asp-validation-for="Title"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control" rows="4" maxlength="300" id="bannerDescription"></textarea>
                        <span asp-validation-for="Description"></span>
                    </div>
                    <button type="submit" class="btn btn-primary btn-icon"><i class="bi bi-check2"></i> Kaydet</button>
                </form>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="form-section-title">Önizleme</div>
        <div class="hero rounded-4 px-4" style="padding-top:3rem;padding-bottom:3rem">
            <h2 class="fw-bold" id="previewTitle">@Model.Title</h2>
            <p class="mb-0 opacity-75" id="previewDescription">@Model.Description</p>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        [['bannerTitle', 'previewTitle'], ['bannerDescription', 'previewDescription']].forEach(function (pair) {
            var input = document.getElementById(pair[0]), out = document.getElementById(pair[1]);
            input.addEventListener('input', function () { out.textContent = input.value; });
        });
    </script>
}
