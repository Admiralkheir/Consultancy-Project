@model IEnumerable<ExpertInfosDTO>
@{
    ViewData["Title"] = "Uzmanlar";
}

<div class="page-header">
    <div>
        <h1>Uzmanlar</h1>
        <p class="lead-text">@Model.Count() uzman</p>
    </div>
    <a class="btn btn-primary btn-icon" asp-action="ExpertAdd"><i class="bi bi-person-plus"></i> Yeni Uzman</a>
</div>

@if (!Model.Any())
{
    <div class="card">
        <div class="empty-state">
            <i class="bi bi-person-badge"></i>
            <p class="mb-3">Henüz uzman kaydı yok. Randevu oluşturabilmek için en az bir uzman ekleyin.</p>
            <a class="btn btn-primary btn-icon" asp-action="ExpertAdd"><i class="bi bi-person-plus"></i> İlk uzmanı ekle</a>
        </div>
    </div>
}
else
{
    <div class="search-input mb-3" style="max-width:340px">
        <i class="bi bi-search"></i>
        <input type="search" class="form-control" placeholder="Ad veya uzmanlık ara…" id="expertSearch" aria-label="Uzman ara" />
    </div>
    <div class="row g-4" id="expertGrid">
        @foreach (var item in Model)
        {
            <div class="col-md-6 col-xl-4" data-search="@item.AdSoyad @item.Uzmanlik">
                <div class="card h-100 lift">
                    <div class="card-body">
                        <div class="d-flex align-items-center gap-3 mb-3">
                            @if (!string.IsNullOrEmpty(item.PhotoURL))
                            {
                                <img class="avatar avatar-lg" src="~/Areas/Ofiice/image/@item.PhotoURL" alt="" />
                            }
                            else
                            {
                                <span class="avatar avatar-lg" style="background:@UiHelper.AvatarColor(item.AdSoyad)">@UiHelper.Initials(item.AdSoyad)</span>
                            }
                            <div class="min-w-0">
                                <a class="row-link fs-5" asp-action="ExpertDetail" asp-route-id="@item.ID">@item.AdSoyad</a>
                                <div class="text-body-secondary">@item.Uzmanlik</div>
                            </div>
                        </div>
                        <div class="small d-grid gap-1 mb-3">
                            <div><i class="bi bi-telephone me-2 text-body-secondary"></i><a class="text-decoration-none" href="tel:@item.Telno">@item.Telno</a></div>
                            <div class="text-truncate"><i class="bi bi-envelope me-2 text-body-secondary"></i>@item.Email</div>
                            <div><i class="bi bi-calendar-event me-2 text-body-secondary"></i>@item.UpcomingCount yaklaşan randevu</div>
                        </div>
                        <div class="d-flex gap-2">
                            <a class="btn btn-sm btn-light flex-fill" asp-action="ExpertDetail" asp-route-id="@item.ID">Profil</a>
                            <a class="btn btn-sm btn-light" asp-action="ExpertUpdate" asp-route-id="@item.ID" title="Düzenle"><i class="bi bi-pencil"></i><span class="visually-hidden">Düzenle</span></a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
    <div id="noExperts" class="empty-state d-none"><i class="bi bi-search"></i>Aramanızla eşleşen uzman yok.</div>
}

@section Scripts {
    <script>
        (function () {
            var input = document.getElementById('expertSearch');
            if (!input) return;
            input.addEventListener('input', function () {
                var term = input.value.trim().toLocaleLowerCase('tr-TR'), visible = 0;
                document.querySelectorAll('#expertGrid [data-search]').forEach(function (col) {
                    var match = col.dataset.search.toLocaleLowerCase('tr-TR').indexOf(term) !== -1;
                    col.classList.toggle('d-none', !match);
                    if (match) visible++;
                });
                document.getElementById('noExperts').classList.toggle('d-none', visible !== 0);
            });
        })();
    </script>
}
