@model ClientVM
@{
    var isNew = Model.Client.ClientID == 0;
    ViewData["Title"] = isNew ? "Yeni Danışan" : "Danışanı Düzenle";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="ListClientInfos">Danışanlar</a></li>
        @if (!isNew)
        {
            <li class="breadcrumb-item"><a asp-action="ClientDetail" asp-route-id="@Model.Client.ClientID">@Model.Client.Name @Model.Client.Surname</a></li>
        }
        <li class="breadcrumb-item active" aria-current="page">@(isNew ? "Yeni" : "Düzenle")</li>
    </ol>
</nav>

<div class="page-header">
    <div>
        <h1>@ViewData["Title"]</h1>
        <p class="lead-text">"İsteğe bağlı" yazmayan tüm alanlar zorunludur.</p>
    </div>
</div>

<form asp-action="ClientUpdate" method="post" novalidate>
    <input asp-for="Client.ClientID" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <div class="row g-4">
        <div class="col-xl-8">
            <div class="card mb-4">
                <div class="card-body">
                    <div class="form-section-title">Kişisel bilgiler</div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Client.Name" class="form-label"></label>
                            <input asp-for="Client.Name" class="form-control" />
                            <span asp-validation-for="Client.Name"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Client.Surname" class="form-label"></label>
                            <input asp-for="Client.Surname" class="form-control" />
                            <span asp-validation-for="Client.Surname"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Client.TcKimlik" class="form-label"></label>
                            <input asp-for="Client.TcKimlik" class="form-control font-monospace" inputmode="numeric" maxlength="11" placeholder="11 haneli" />
                            <span asp-validation-for="Client.TcKimlik"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Client.BirthDate" class="form-label"></label>
                            <input asp-for="Client.BirthDate" type="date" class="form-control" max="@DateTime.Today.ToString("yyyy-MM-dd")" value="@(Model.Client.BirthDate == default ? "" : Model.Client.BirthDate.ToString("yyyy-MM-dd"))" />
                            <span asp-validation-for="Client.BirthDate"></span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card mb-4">
                <div class="card-body">
                    <div class="form-section-title">İletişim</div>
                    <partial name="_ContactFields" for="Contact" />
                </div>
            </div>
        </div>
        <div class="col-xl-4">
            <div class="card mb-4">
                <div class="card-body">
                    <div class="form-section-title">Başvuru</div>
                    <div class="mb-3">
                        <label asp-for="Client.Problem" class="form-label"></label>
                        <textarea asp-for="Client.Problem" class="form-control" rows="5" maxlength="450" data-counter="#problemCount"></textarea>
                        <div class="d-flex justify-content-between"><span asp-validation-for="Client.Problem"></span><small class="text-body-secondary ms-auto" id="problemCount"></small></div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Client.Note" class="form-label"></label> <span class="text-body-secondary small">(isteğe bağlı)</span>
                        <textarea asp-for="Client.Note" class="form-control" rows="3" maxlength="450"></textarea>
                        <span asp-validation-for="Client.Note"></span>
                    </div>
                    @if (!isNew)
                    {
                        <div class="form-check form-switch">
                            <input asp-for="Client.Continuity" class="form-check-input" role="switch" />
                            <label asp-for="Client.Continuity" class="form-check-label">Danışan devam ediyor</label>
                        </div>
                        <small class="text-body-secondary">Pasif danışanlar randevu formunda listelenmez.</small>
                    }
                </div>
            </div>
            <div class="d-grid gap-2">
                <button type="submit" class="btn btn-primary btn-icon justify-content-center"><i class="bi bi-check2"></i> @(isNew ? "Danışanı Kaydet" : "Değişiklikleri Kaydet")</button>
                @if (isNew)
                {
                    <a class="btn btn-light" asp-action="ListClientInfos">Vazgeç</a>
                }
                else
                {
                    <a class="btn btn-light" asp-action="ClientDetail" asp-route-id="@Model.Client.ClientID">Vazgeç</a>
                }
            </div>
        </div>
    </div>
</form>
