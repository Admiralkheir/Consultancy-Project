@model DDLsVM
@{
    ViewData["Title"] = "Randevu Takvimi";
    var canBook = Model.ExpertsList.Any() && Model.ClientsList.Any();
}

<div class="page-header">
    <div>
        <h1>Randevu Takvimi</h1>
        <p class="lead-text">Boş bir saate tıklayarak randevu oluşturun; randevuları sürükleyerek taşıyın.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <select class="form-select" id="expertFilter" aria-label="Uzmana göre filtrele" style="min-width:200px">
            <option value="">Tüm uzmanlar</option>
            @foreach (var expert in Model.ExpertsList)
            {
                <option value="@expert.Value" selected="@(expert.Value == Model.SelectedExpertId.ToString())">@expert.Text</option>
            }
        </select>
        <button type="button" class="btn btn-primary btn-icon" id="newAppointment" disabled="@(!canBook)"><i class="bi bi-plus-lg"></i> Yeni Randevu</button>
    </div>
</div>

@if (!canBook)
{
    <div class="alert alert-warning d-flex gap-2 align-items-start">
        <i class="bi bi-info-circle mt-1"></i>
        <div>
            Randevu oluşturmak için en az bir uzman ve bir aktif danışan gerekir.
            @if (!Model.ExpertsList.Any()) { <a asp-action="ExpertAdd" class="alert-link">Uzman ekleyin</a> }
            @if (!Model.ExpertsList.Any() && !Model.ClientsList.Any()) { <span>ve</span> }
            @if (!Model.ClientsList.Any()) { <a asp-action="ClientAdd" class="alert-link">danışan ekleyin</a> }.
        </div>
    </div>
}

<div class="card">
    <div class="card-body">
        <div id="calendar"
             data-events-url="@Url.Action("GetEvents")"
             data-save-url="@Url.Action("SaveEvent")"
             data-delete-url="@Url.Action("DeleteEvent")"
             data-can-book="@(canBook ? "true" : "false")"></div>
    </div>
</div>

<div class="modal fade" id="appointmentModal" tabindex="-1" aria-labelledby="appointmentModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <form class="modal-content" id="appointmentForm" novalidate>
            <div class="modal-header">
                <h5 class="modal-title" id="appointmentModalTitle">Yeni randevu</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-danger d-none" id="apptError" role="alert"></div>
                <input type="hidden" id="apptId" value="0" />
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label" for="apptExpert">Uzman</label>
                        <select class="form-select" id="apptExpert" required>
                            @foreach (var expert in Model.ExpertsList)
                            {
                                <option value="@expert.Value">@expert.Text</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="apptClient">Danışan</label>
                        <select class="form-select" id="apptClient" required>
                            @foreach (var client in Model.ClientsList)
                            {
                                <option value="@client.Value">@client.Text</option>
                            }
                        </select>
                    </div>
                    <div class="col-12">
                        <label class="form-label" for="apptSubject">Konu</label>
                        <input class="form-control" id="apptSubject" maxlength="100" placeholder="örn. Bireysel seans" required />
                    </div>
                    <div class="col-md-5">
                        <label class="form-label" for="apptDate">Tarih</label>
                        <input class="form-control" type="date" id="apptDate" required />
                    </div>
                    <div class="col-6 col-md-3 time-field">
                        <label class="form-label" for="apptStart">Başlangıç</label>
                        <input class="form-control" type="time" id="apptStart" step="300" />
                    </div>
                    <div class="col-6 col-md-3 time-field">
                        <label class="form-label" for="apptEnd">Bitiş</label>
                        <input class="form-control" type="time" id="apptEnd" step="300" />
                    </div>
                    <div class="col-12">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" role="switch" id="apptAllDay" />
                            <label class="form-check-label" for="apptAllDay">Tüm gün</label>
                        </div>
                    </div>
                    <div class="col-12">
                        <label class="form-label" for="apptDescription">Not <span class="text-body-secondary small fw-normal">(isteğe bağlı)</span></label>
                        <textarea class="form-control" id="apptDescription" rows="2" maxlength="450"></textarea>
                    </div>
                    <div class="col-12">
                        <span class="form-label d-block">Renk</span>
                        <div class="color-swatches" role="radiogroup" aria-label="Renk">
                            @foreach (var (value, name) in AppointmentColors.All)
                            {
                                var id = "color" + value.TrimStart('#');
                                <input type="radio" name="apptColor" id="@id" value="@value" checked="@(value == AppointmentColors.Default)" />
                                <label for="@id" style="background:@value" title="@name"><span class="visually-hidden">@name</span></label>
                            }
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-danger me-auto d-none" id="apptDelete"><i class="bi bi-trash me-1"></i>Sil</button>
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Vazgeç</button>
                <button type="submit" class="btn btn-primary" id="apptSave">Kaydet</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/lib/fullcalendar/index.global.min.js"></script>
    <script src="~/lib/fullcalendar/tr.global.min.js"></script>
    <script src="~/js/calendar.js" asp-append-version="true"></script>
}
