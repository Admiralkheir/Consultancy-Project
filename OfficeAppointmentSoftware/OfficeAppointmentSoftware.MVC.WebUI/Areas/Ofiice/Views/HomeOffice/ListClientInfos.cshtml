@model IEnumerable<ClientInfosDTO>
@{
    ViewData["Title"] = "Danışanlar";
    var activeCount = Model.Count(x => x.DevamDurumu);
}

<div class="page-header">
    <div>
        <h1>Danışanlar</h1>
        <p class="lead-text">@activeCount aktif, @(Model.Count() - activeCount) pasif danışan</p>
    </div>
    <a class="btn btn-primary btn-icon" asp-action="ClientAdd"><i class="bi bi-person-plus"></i> Yeni Danışan</a>
</div>

<div class="card">
    @if (!Model.Any())
    {
        <div class="empty-state">
            <i class="bi bi-people"></i>
            <p class="mb-3">Henüz danışan kaydı yok.</p>
            <a class="btn btn-primary btn-icon" asp-action="ClientAdd"><i class="bi bi-person-plus"></i> İlk danışanı ekle</a>
        </div>
    }
    else
    {
        <div class="card-header">
            <div class="search-input w-100" style="max-width:340px">
                <i class="bi bi-search"></i>
                <input type="search" class="form-control" placeholder="Ad, TC kimlik, telefon ara…" data-table-search="#clientTable" aria-label="Danışan ara" />
            </div>
        </div>
        <div class="table-responsive">
            <table class="table table-hover" id="clientTable">
                <thead>
                    <tr>
                        <th>Danışan</th>
                        <th>Grup</th>
                        <th class="d-none d-md-table-cell">TC Kimlik No</th>
                        <th>Telefon</th>
                        <th>Durum</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    <span class="avatar" style="background:@UiHelper.AvatarColor(item.AdSoyad)">@UiHelper.Initials(item.AdSoyad)</span>
                                    <div>
                                        <a class="row-link" asp-action="ClientDetail" asp-route-id="@item.ID">@item.AdSoyad</a>
                                        <div class="small text-body-secondary">@item.Email</div>
                                    </div>
                                </div>
                            </td>
                            <td><span class="text-nowrap">@item.DanisanTuru</span> <span class="small text-body-secondary">(@item.Yas)</span></td>
                            <td class="d-none d-md-table-cell font-monospace small">@item.TCKimlik</td>
                            <td class="text-nowrap"><a class="text-decoration-none" href="tel:@item.Telno">@item.Telno</a></td>
                            <td>
                                @if (item.DevamDurumu)
                                {
                                    <span class="badge rounded-pill text-bg-success bg-opacity-75">Aktif</span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill text-bg-secondary">Pasif</span>
                                }
                            </td>
                            <td class="text-end text-nowrap">
                                <a class="btn btn-sm btn-light" asp-action="ClientUpdate" asp-route-id="@item.ID" title="Düzenle"><i class="bi bi-pencil"></i><span class="visually-hidden">Düzenle</span></a>
                                <form asp-action="ClientDelete" asp-route-id="@item.ID" method="post" class="d-inline"
                                      data-confirm="@item.AdSoyad ve tüm randevuları kalıcı olarak silinecek. Bu işlem geri alınamaz." data-confirm-title="Danışan silinsin mi?">
                                    <button type="submit" class="btn btn-sm btn-light text-danger" title="Sil"><i class="bi bi-trash"></i><span class="visually-hidden">Sil</span></button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <div id="noResults" class="empty-state d-none"><i class="bi bi-search"></i>Aramanızla eşleşen danışan yok.</div>
        </div>
    }
</div>
