@model ClientExpertVM
@{
    ViewData["Title"] = "Genel Bakış";
    var hour = DateTime.Now.Hour;
    var greeting = hour < 12 ? "Günaydın" : hour < 18 ? "İyi günler" : "İyi akşamlar";
}

<div class="page-header">
    <div>
        <h1>@greeting</h1>
        <p class="lead-text">@UiHelper.Date(DateTime.Today), @UiHelper.DayName(DateTime.Today) · @Model.Company?.CompanyName</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-primary btn-icon" asp-action="ClientAdd"><i class="bi bi-person-plus"></i> Yeni Danışan</a>
        <a class="btn btn-primary btn-icon" asp-action="AppointmentOpss"><i class="bi bi-calendar-plus"></i> Randevu Oluştur</a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-xl-3">
        <div class="card h-100"><div class="card-body stat-card">
            <span class="stat-icon tone-indigo"><i class="bi bi-calendar-check"></i></span>
            <div><div class="stat-value">@Model.AppsToday</div><div class="stat-label">Bugünkü randevu</div></div>
        </div></div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="card h-100"><div class="card-body stat-card">
            <span class="stat-icon tone-teal"><i class="bi bi-calendar-week"></i></span>
            <div><div class="stat-value">@Model.AppsThisWeek</div><div class="stat-label">Bu haftaki randevu</div></div>
        </div></div>
    </div>
    <div class="col-6 col-xl-3">
        <a class="card h-100 text-decoration-none lift" asp-action="ListClientInfos"><div class="card-body stat-card">
            <span class="stat-icon tone-amber"><i class="bi bi-people"></i></span>
            <div><div class="stat-value">@Model.ClientTotal</div><div class="stat-label">Aktif danışan</div></div>
        </div></a>
    </div>
    <div class="col-6 col-xl-3">
        <a class="card h-100 text-decoration-none lift" asp-action="ListExpertInfos"><div class="card-body stat-card">
            <span class="stat-icon tone-rose"><i class="bi bi-person-badge"></i></span>
            <div><div class="stat-value">@Model.ExpertsTotal</div><div class="stat-label">Uzman</div></div>
        </div></a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card h-100">
            <div class="card-header">
                <span><i class="bi bi-clock me-2 text-primary"></i>Bugünün programı</span>
                <a class="small text-decoration-none" asp-action="AppointmentOpss">Takvimi aç <i class="bi bi-arrow-right"></i></a>
            </div>
            <div class="card-body pt-0">
                <partial name="_AgendaList" model="Model.TodaysAppointments" view-data='new ViewDataDictionary(ViewData) { ["EmptyText"] = "Bugün için planlanmış randevu yok." }' />
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card mb-4">
            <div class="card-header"><span><i class="bi bi-hourglass-split me-2 text-primary"></i>Yaklaşan randevular</span></div>
            <div class="card-body pt-0">
                <partial name="_AgendaList" model="Model.UpcomingAppointments" view-data='new ViewDataDictionary(ViewData) { ["ShowDate"] = true, ["EmptyText"] = "Yaklaşan randevu yok." }' />
            </div>
        </div>
        <div class="card">
            <div class="card-header">
                <span><i class="bi bi-pie-chart me-2 text-primary"></i>Danışan yaş dağılımı</span>
                <span class="small text-body-secondary">Aktif danışanlar</span>
            </div>
            <div class="card-body">
                @if (Model.ClientTotal == 0)
                {
                    <div class="empty-state py-3"><i class="bi bi-people"></i>Henüz aktif danışan yok.</div>
                }
                else
                {
                    var tones = new[] { "bg-warning", "bg-info", "bg-primary", "bg-success" };
                    var i = 0;
                    @foreach (var group in Model.AgeGroups)
                    {
                        <div class="mb-3">
                            <div class="d-flex justify-content-between small mb-1">
                                <span><span class="fw-semibold">@group.Name</span> <span class="text-body-secondary">(@group.Range)</span></span>
                                <span class="text-body-secondary">@group.Count kişi · %@group.Percent</span>
                            </div>
                            <div class="progress" role="progressbar" aria-label="@group.Name" aria-valuenow="@group.Percent" aria-valuemin="0" aria-valuemax="100">
                                <div class="progress-bar @tones[i++ % tones.Length]" style="width:@(group.Percent.ToString(System.Globalization.CultureInfo.InvariantCulture))%"></div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>
