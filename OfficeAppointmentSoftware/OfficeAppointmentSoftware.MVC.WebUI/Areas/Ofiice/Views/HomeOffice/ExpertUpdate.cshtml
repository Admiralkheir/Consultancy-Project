@model ExpertVM
@{
    var isNew = Model.Expert.ExpertID == 0;
    var fullName = (Model.Expert.Name + " " + Model.Expert.Surname).Trim();
    ViewData["Title"] = isNew ? "Yeni Uzman" : "Uzmanı Düzenle";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="ListExpertInfos">Uzmanlar</a></li>
        @if (!isNew)
        {
            <li class="breadcrumb-item"><a asp-action="ExpertDetail" asp-route-id="@Model.Expert.ExpertID">@fullName</a></li>
        }
        <li class="breadcrumb-item active" aria-current="page">@(isNew ? "Yeni" : "Düzenle")</li>
    </ol>
</nav>

<div class="page-header">
    <div>
        <h1>@ViewData["Title"]</h1>
        <p class="lead-text">"İsteğe bağlı" yazmayan tüm alanlar zorunludur.</p>
    </div>
</div>

<form asp-action="ExpertUpdate" method="post" enctype="multipart/form-data" novalidate>
    <input asp-for="Expert.ExpertID" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <div class="row g-4">
        <div class="col-xl-8">
            <div class="card mb-4">
                <div class="card-body">
                    <div class="form-section-title">Kişisel bilgiler</div>
                    <div class="d-flex align-items-center gap-3 mb-4">
                        @if (!string.IsNullOrEmpty(Model.Expert.PhotoURL))
                        {
                            <img id="photoPreview" class="photo-preview" src="~/Areas/Ofiice/image/@Model.Expert.PhotoURL" alt="" />
                        }
                        else
                        {
                            <img id="photoPreview" class="photo-preview d-none" alt="" />
                            <span id="photoPlaceholder" class="avatar avatar-lg bg-secondary-subtle text-body-secondary"><i class="bi bi-camera"></i></span>
                        }
                        <div>
                            <label class="form-label" for="photoFile">Fotoğraf <span class="text-body-secondary small fw-normal">(isteğe bağlı)</span></label>
                            <input class="form-control form-control-sm" type="file" name="file" id="photoFile" accept="image/*" data-preview="#photoPreview" data-preview-placeholder="#photoPlaceholder" />
                            @Html.ValidationMessage("file")
                            <div class="form-text">PNG, JPG veya GIF, en fazla 500 KB.</div>
                        </div>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Expert.Name" class="form-label"></label>
                            <input asp-for="Expert.Name" class="form-control" />
                            <span asp-validation-for="Expert.Name"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Expert.Surname" class="form-label"></label>
                            <input asp-for="Expert.Surname" class="form-control" />
                            <span asp-validation-for="Expert.Surname"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Expert.Profession" class="form-label"></label>
                            <input asp-for="Expert.Profession" class="form-control" placeholder="örn. Klinik Psikolog" list="professions" />
                            <datalist id="professions">
                                <option value="Psikolog"></option>
                                <option value="Klinik Psikolog"></option>
                                <option value="Psikolojik Danışman"></option>
                                <option value="Aile Danışmanı"></option>
                                <option value="Çocuk ve Ergen Psikoloğu"></option>
                                <option value="Psikiyatrist"></option>
                            </datalist>
                            <span asp-validation-for="Expert.Profession"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Expert.BirthDate" class="form-label"></label>
                            <input asp-for="Expert.BirthDate" type="date" class="form-control" max="@DateTime.Today.ToString("yyyy-MM-dd")" value="@(Model.Expert.BirthDate == default ? "" : Model.Expert.BirthDate.ToString("yyyy-MM-dd"))" />
                            <span asp-validation-for="Expert.BirthDate"></span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card mb-4">
                <div class="card-body">
                    <div class="form-section-title">İletişim</div>
                    <partial name="_ContactFields" for="Contact" />
                </div>
            </div>
        </div>
        <div class="col-xl-4">
            <div class="card mb-4">
                <div class="card-body">
                    <div class="form-section-title">Çalışma bilgileri</div>
                    <div class="mb-3">
                        <label asp-for="Expert.WagePolicy" class="form-label"></label>
                        <textarea asp-for="Expert.WagePolicy" class="form-control" rows="5" maxlength="450" placeholder="örn. Bireysel seans 50 dk: 1.500 ₺" data-counter="#wageCount"></textarea>
                        <div class="d-flex"><span asp-validation-for="Expert.WagePolicy"></span><small class="text-body-secondary ms-auto" id="wageCount"></small></div>
                    </div>
                    <div>
                        <label asp-for="Expert.Note" class="form-label"></label> <span class="text-body-secondary small">(isteğe bağlı)</span>
                        <textarea asp-for="Expert.Note" class="form-control" rows="3" maxlength="450"></textarea>
                        <span asp-validation-for="Expert.Note"></span>
                    </div>
                </div>
            </div>
            <div class="d-grid gap-2">
                <button type="submit" class="btn btn-primary btn-icon justify-content-center"><i class="bi bi-check2"></i> @(isNew ? "Uzmanı Kaydet" : "Değişiklikleri Kaydet")</button>
                @if (isNew)
                {
                    <a class="btn btn-light" asp-action="ListExpertInfos">Vazgeç</a>
                }
                else
                {
                    <a class="btn btn-light" asp-action="ExpertDetail" asp-route-id="@Model.Expert.ExpertID">Vazgeç</a>
                }
            </div>
        </div>
    </div>
</form>
